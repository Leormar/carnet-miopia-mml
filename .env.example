# ---------------------------------------------------------------------------
# Base de datos: Neon Serverless Postgres
# Panel de Neon -> su proyecto -> Connection string -> "Pooled connection"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# NextAuth
# AUTH_SECRET se genera con:  npx auth secret
# AUTH_URL solo hace falta en produccion con dominio propio.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="https://seguimiento.miopialatam.org"

# Google Cloud -> APIs y servicios -> Credenciales -> ID de cliente de OAuth 2.0
# URI de redireccion autorizado:
#   https://seguimiento.miopialatam.org/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple (opcional). Si estas dos quedan vacias, el boton de Apple no se muestra.
# Requiere Apple Developer Program. Return URL:
#   https://seguimiento.miopialatam.org/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ---------------------------------------------------------------------------
# Acceso cerrado
# Correos separados por coma que entran ya aprobados y como administradores.
# ---------------------------------------------------------------------------
ADMIN_EMAILS="drorjuela@lentesespecializados.com"
